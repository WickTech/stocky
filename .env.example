# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Used only by the TradingAgents spike in .venv-ta (Plan 02 Phase D).

# LLM — pick ONE free provider to start (Gemini is the easiest free key):
GOOGLE_API_KEY=            # https://aistudio.google.com/apikey
# GROQ_API_KEY=            # https://console.groq.com/keys
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (use :free models)

# Optional data / sentiment
ALPHA_VANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key (free tier)
FRED_API_KEY=              # https://fred.stlouisfed.org/docs/api/api_key.html (free)
TYPESAFE_API_KEY=          # https://console.typesafe.ai/keys  (Jev sentiment; free tier unverified)
